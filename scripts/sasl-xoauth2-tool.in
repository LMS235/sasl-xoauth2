##########

# These are set by CMake at project build time.

TEST_TOOL_PATH = '${CMAKE_INSTALL_FULL_LIBDIR}/${PROJECT_NAME}/test-config'
DEFAULT_CONFIG_FILE = '${CMAKE_INSTALL_FULL_SYSCONFDIR}/${PROJECT_NAME}.conf'
VERSION = '${PROJECT_VERSION}'

##########

GOOGLE_OAUTH2_AUTH_URL = 'https://accounts.google.com/o/oauth2/auth'
GOOGLE_OAUTH2_TOKEN_URL = 'https://accounts.google.com/o/oauth2/token'
GOOGLE_OAUTH2_RESULT_PATH = '/oauth2_result'


def url_safe_escape(instring:str) -> str:
    return urllib.parse.quote(instring, safe='~-._')


def pkce_pair() -> Dict[str,str]:
    """Returns a PKCE (RFC 7636) code verifier and its S256 challenge."""
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode('ascii')).digest()).decode('ascii').rstrip('=')
    return {'verifier': verifier, 'challenge': challenge}


def expiry_from_response(response:Dict[str,Any]) -> int:
    """Absolute expiry for a token response, or 0 (refresh on first use)."""
    try:
        return int(time.time()) + int(response['expires_in'])
    except (KeyError, TypeError, ValueError):
        return 0


def post_token_request(url:str, params:Dict[str,str]) -> Dict[str,Any]:
    """POSTs a token request; raises with the provider's reason on failure."""
    request = urllib.request.Request(
        url,
        data=urllib.parse.urlencode(params).encode('ascii'),
        headers={"Content-Type": "application/x-www-form-urlencoded",
                 "Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=60) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        body = e.read().decode('utf-8', errors='replace')
        try:
            error = json.loads(body)
            reason = f"{error.get('error')}: {error.get('error_description')}"
        except ValueError:
            reason = body
        raise Exception(f"Token request to {url} failed with HTTP {e.code}: {reason}") from None


def open_token_lock(output_filename:str) -> Optional[int]:
    """Takes the lock the plugin takes while refreshing (<token file>.lock), so
    that a token update and a plugin refresh cannot overwrite each other."""
    lock_path = output_filename + '.lock'
    try:
        fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except OSError as e:
        print(f"Warning: cannot open lock file {lock_path}: {e}", file=sys.stderr)
        return None
    # A lock file created here (e.g. by root) must stay usable for the plugin:
    # give it the owner of the token file, or of its directory.
    try:
        owner = os.lstat(output_filename) if os.path.lexists(output_filename) else \
            os.stat(os.path.dirname(os.path.abspath(output_filename)))
        st = os.fstat(fd)
        if (st.st_uid, st.st_gid) != (owner.st_uid, owner.st_gid):
            os.fchown(fd, owner.st_uid, owner.st_gid)
    except OSError:
        pass
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def dump_overwrite(token:dict, output_filename:str, merge_existing:bool,
                   adjust:Optional[Callable[[dict], None]] = None) -> None:
    """Writes |token| to |output_filename| ('-' for stdout). With
    |merge_existing|, the fields of the current file are kept unless |token|
    replaces them; |adjust| may change the merged result before writing."""
    if output_filename == '-':
        json.dump(token, sys.stdout, indent=4)
        print()
        return
    lock_fd = open_token_lock(output_filename)
    try:
        # Never write through (or copy the owner of) a symlink planted in the
        # token directory.
        existing = None
        if os.path.lexists(output_filename):
            existing = os.lstat(output_filename)
            if not stat.S_ISREG(existing.st_mode):
                raise Exception(f"Refusing to write {output_filename}: not a regular file (symlink?)")
        contents:dict = {}
        if merge_existing:
            if existing is None:
                raise Exception(f"Cannot overwrite nonexistent token file {output_filename}")
            # Read under the lock: the plugin may have just updated the file.
            fd = os.open(output_filename, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
            with os.fdopen(fd, 'r') as input_file:
                contents = json.load(input_file)
        contents.update(token)
        if adjust:
            adjust(contents)

        # The token file holds secrets: create it readable by its owner only (or
        # keep the owner/group bits of the file it replaces), and replace it
        # atomically so a failure never leaves a truncated token file behind.
        mode = 0o600
        if existing:
            mode |= stat.S_IMODE(existing.st_mode) & 0o770
        directory = os.path.dirname(os.path.abspath(output_filename))
        fd, temp_path = tempfile.mkstemp(dir=directory, prefix='.sasl-xoauth2-')
        try:
            if existing:
                # Keep the file usable by its owner (e.g. Postfix) when updated by
                # another user (e.g. root).
                try:
                    os.fchown(fd, existing.st_uid, existing.st_gid)
                except PermissionError:
                    print(f"Warning: could not keep owner of {output_filename}; check its ownership.",
                          file=sys.stderr)
                    mode &= 0o700
            os.fchmod(fd, mode)
            with os.fdopen(fd, 'w') as output_file:
                json.dump(contents, output_file, indent=4)
                output_file.write('\n')
                output_file.flush()
                os.fsync(output_file.fileno())
            os.replace(temp_path, output_filename)
        except BaseException:
            os.unlink(temp_path)
            raise
    finally:
        if lock_fd is not None:
            os.close(lock_fd)


def run_test_tool(test_args:list) -> int:
    """Runs test-config the way Postfix runs the plugin: without proxy (or
    other) environment variables, which Postfix does not pass on."""
    proxy_vars = sorted(v for v in os.environ
                        if v.lower() in ('http_proxy', 'https_proxy', 'all_proxy', 'no_proxy'))
    if proxy_vars:
        print(f"Note: ignoring {', '.join(proxy_vars)} from the environment, as Postfix "
              "does; set 'proxy' in the configuration if a proxy is needed.", file=sys.stderr)
    env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C'}
    if 'TZ' in os.environ:
        env['TZ'] = os.environ['TZ']
    return subprocess.run([TEST_TOOL_PATH] + test_args, shell=False, env=env).returncode


def gmail_redirect_uri(local_port:int) -> str:
    return 'http://127.0.0.1:%d%s' % (local_port, GOOGLE_OAUTH2_RESULT_PATH)


def gmail_get_auth_url(client_id:str, scope:str, local_port:int, state:str, code_challenge:str) -> str:
    query = {
        'client_id': client_id,
        'scope': scope,
        'response_type': 'code',
        'redirect_uri': gmail_redirect_uri(local_port),
        'access_type': 'offline',
        'prompt': 'consent',
        'state': state,
        'code_challenge': code_challenge,
        'code_challenge_method': 'S256',
    }
    return f"{GOOGLE_OAUTH2_AUTH_URL}?{urllib.parse.urlencode(query, quote_via=urllib.parse.quote)}"


def gmail_get_token_from_code(client_id:str, client_secret:str, authorization_code:str, local_port:int, code_verifier:str) -> Any:
    params = {}
    params['client_id'] = client_id
    params['client_secret'] = client_secret
    params['code'] = authorization_code
    params['code_verifier'] = code_verifier
    params['redirect_uri'] = gmail_redirect_uri(local_port)
    params['grant_type'] = 'authorization_code'
    return post_token_request(GOOGLE_OAUTH2_TOKEN_URL, params)


def gmail_get_RequestHandler(client_id:str, client_secret:str, output_filename:str, merge_existing:bool, state:str, code_verifier:str) -> type:
    class GMailRequestHandler(http.server.BaseHTTPRequestHandler):
        def log_request(self, code:Union[int,str]='-', size:Union[int,str]='-') -> None:
            # Silence request logging.
            return

        def do_GET(self) -> None:
            # Only the redirect from Google is served. (The authorization URL,
            # with its state and PKCE challenge, is only printed, never served:
            # other local users could otherwise fetch it.)
            parse = urllib.parse.urlparse(self.path)
            if parse.path == GOOGLE_OAUTH2_RESULT_PATH:
              self.handle_google_response(parse)
            else:
              self.send_response(404)
              self.end_headers()

        def handle_google_response(self, parse:urllib.parse.ParseResult) -> None:
            qs = urllib.parse.parse_qs(parse.query)
            # Reject responses not caused by our own authorization request.
            if qs.get('state') != [state]:
                print("Ignoring response with missing or mismatched state.", file=sys.stderr)
                self.send_response(400)
                self.end_headers()
                return
            if 'code' not in qs:
                print(f"Invalid query string in response '{qs}'", file=sys.stderr)
                return
            if len(qs['code']) != 1:
                print(f"Invalid query string code in response '{qs}'", file=sys.stderr)
                return
            code = qs['code'][0]

            response_code = 400
            response_text = '<html><head><title>Error</title></head><body><h1>Invalid request.</h1></body></html>'

            if code:
                response_code = 200
                response_text = '<html><head><title>Done</title></head><body><h1>You may close this window now.</h1></body></html>'

            self.send_response(response_code)
            self.send_header('Content-type', 'text/html')
            self.end_headers()
            self.wfile.write(response_text.encode('utf8'))

            if code:
                token = gmail_get_token_from_code(
                    client_id,
                    client_secret,
                    code,
                    self.server.server_address[1],
                    code_verifier,
                )
                if 'refresh_token' not in token:
                    print("Response contains no refresh token.", file=sys.stderr)
                    os._exit(1)
                # Store only what the plugin uses.
                token = {
                    'access_token': token['access_token'],
                    'refresh_token': token['refresh_token'],
                    'expiry': expiry_from_response(token),
                }
                dump_overwrite(token, output_filename, merge_existing)
                print(f"Wrote token to {output_filename}.", file=sys.stderr)
                os._exit(0)

    return GMailRequestHandler


def get_token_gmail(client_id:str, client_secret:str, scope:str, output_filename:str, local_listen_port:int, local_listen_address:str, merge_existing:bool) -> None:
    state = secrets.token_urlsafe(32)
    pkce = pkce_pair()
    auth_url = gmail_get_auth_url(client_id, scope, local_listen_port, state, pkce['challenge'])
    request_handler_class = gmail_get_RequestHandler(
        client_id,
        client_secret,
        output_filename,
        merge_existing,
        state,
        pkce['verifier'],
    )
    # Only reachable from this host by default (or through an SSH tunnel).
    server = http.server.HTTPServer((local_listen_address, local_listen_port), request_handler_class)

    print(f"Please open this URL in a browser ON THIS HOST (or one that has port {local_listen_port} forwarded to this host):\n\n{auth_url}\n", file=sys.stderr)

    server.serve_forever()

