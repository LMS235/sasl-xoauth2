# Predefined cloud configurations for Microsoft 365 national clouds.
# Each entry maps a cloud name to its login base URL, its delegated SMTP scope
# and its app-only (client credentials) scope.
OUTLOOK_CLOUD_CONFIGS = {
    "public": {
        "login_base": "https://login.microsoftonline.com",
        "app_scope": "https://outlook.office365.com/.default",
        "scope": "offline_access https://outlook.office.com/SMTP.Send",
    },
    "usgov": {
        "login_base": "https://login.microsoftonline.us",
        "app_scope": "https://outlook.office365.us/.default",
        "scope": "offline_access https://outlook.office365.us/SMTP.Send",
    },
    "usgov-dod": {
        "login_base": "https://login.microsoftonline.us",
        "app_scope": "https://outlook.office365.us/.default",
        "scope": "offline_access https://outlook.office365.us/SMTP.Send",
    },
    "china": {
        "login_base": "https://login.partner.microsoftonline.cn",
        "app_scope": "https://partner.outlook.cn/.default",
        "scope": "offline_access https://partner.outlook.cn/SMTP.Send",
    },
}


def outlook_get_cloud_config(cloud:str, login_base_override:Optional[str], scope_override:Optional[str]) -> Dict[str,str]:
    """Resolve cloud config: explicit overrides take precedence over presets."""
    if cloud not in OUTLOOK_CLOUD_CONFIGS:
        raise Exception(f"Unknown cloud '{cloud}'. Known clouds: {', '.join(OUTLOOK_CLOUD_CONFIGS.keys())}")
    config = dict(OUTLOOK_CLOUD_CONFIGS[cloud])
    if login_base_override and not login_base_override.startswith('https://'):
        raise Exception("--login-base must be an https:// URL.")
    if login_base_override:
        config["login_base"] = login_base_override
        if not scope_override:
            print(f"Warning: --login-base is set but --scope is not. The default scope "
                  f"from the '{cloud}' cloud preset will be used. If your environment "
                  f"uses a different mail domain, you may also need --scope.",
                  file=sys.stderr)
    if scope_override:
        config["scope"] = scope_override
    return config


def outlook_token_endpoint(tenant:str, cloud_config:Dict[str,str]) -> str:
    return f"{cloud_config['login_base']}/{tenant}/oauth2/v2.0/token"


def outlook_get_authorization_code(client_id:str, tenant:str, cloud_config:Dict[str,str], state:str, code_challenge:str) -> str:
    login_base = cloud_config["login_base"]
    scope = cloud_config["scope"]
    redirect_uri = f"{login_base}/common/oauth2/nativeclient"
    url = f"{login_base}/{tenant}/oauth2/v2.0/authorize"
    query:Dict[str,str] = {}
    query['client_id'] = client_id
    query['response_type'] = 'code'
    query['redirect_uri'] = redirect_uri
    query['response_mode'] = 'query'
    query['scope'] = scope
    query['state'] = state
    query['code_challenge'] = code_challenge
    query['code_challenge_method'] = 'S256'

    print("Please visit the following link in a web browser, then paste the resulting URL:\n\n" +
          f"{url}?{urllib.parse.urlencode(query)}\n",
          file=sys.stderr)

    resulting_url_input:str = input("Resulting URL: ")
    if redirect_uri not in resulting_url_input:
        raise Exception(f"Resulting URL does not contain expected prefix: {redirect_uri}")
    resulting_url = urllib.parse.urlparse(resulting_url_input)
    code = urllib.parse.parse_qs(resulting_url.query)
    if "error" in code:
        raise Exception(f"Authorization failed: {code['error'][0]}: {code.get('error_description', [''])[0]}")
    if code.get("state") != [state]:
        raise Exception("Resulting URL has a missing or mismatched state; was it produced by this request?")
    if "code" not in code:
        raise Exception("Missing code in resulting URL.")
    return code["code"][0]


def outlook_get_initial_tokens(client_id:str, client_secret:Optional[str], tenant:str, code:str, cloud_config:Dict[str,str], code_verifier:str) -> Dict[str,Union[str,int]]:
    login_base = cloud_config["login_base"]
    scope = cloud_config["scope"]
    redirect_uri = f"{login_base}/common/oauth2/nativeclient"
    token_request:Dict[str,str] = {}
    token_request['client_id'] = client_id
    if client_secret:
      token_request['client_secret'] = client_secret
    token_request['scope'] = scope
    token_request['code'] = code
    token_request['code_verifier'] = code_verifier
    token_request['redirect_uri'] = redirect_uri
    token_request['grant_type'] = 'authorization_code'
    content = post_token_request(outlook_token_endpoint(tenant, cloud_config), token_request)
    if "access_token" not in content or "refresh_token" not in content:
        raise Exception(f"Tokens not found in response (fields: {', '.join(sorted(content.keys()))}). "
                        "Is 'offline_access' part of the scope?")
    return {
        'access_token': content["access_token"],
        'refresh_token': content["refresh_token"],
        'expiry': expiry_from_response(content),
    }


# MSAL always requests these itself and rejects them in a scope list.
MSAL_RESERVED_SCOPES = {"openid", "profile", "offline_access"}


def outlook_get_initial_tokens_by_device_flow(client_id:str, tenant:str, cloud_config:Dict[str,str]) -> Dict[str,Union[str,int]]:
    import msal  # Only needed for this flow.
    login_base = cloud_config["login_base"]
    scopes = [s for s in cloud_config["scope"].split() if s not in MSAL_RESERVED_SCOPES]
    authority = f"{login_base}/{tenant}"
    app = msal.PublicClientApplication(client_id, authority=authority)
    flow = app.initiate_device_flow(scopes)
    if "user_code" not in flow:
        raise Exception("Failed to create device flow. Ensure that public client flows are enabled for the application. Flow: %s" % json.dumps(flow, indent=4))
    print(flow["message"], file=sys.stderr)
    sys.stderr.flush()
    result = app.acquire_token_by_device_flow(flow)
    if "access_token" not in result or "refresh_token" not in result:
        raise Exception("Failed to acquire token: %s: %s" % (result.get("error"), result.get("error_description")))
    print("Acquired token.", file=sys.stderr)
    return {
        'access_token': result["access_token"],
        'refresh_token': result["refresh_token"],
        'expiry': expiry_from_response(result),
    }


def outlook_client_credentials_with_certificate(client_id:str, tenant:str, cloud_config:Dict[str,str], mailbox:Optional[str], certificate:str, private_key:Optional[str]) -> Dict[str,Union[str,int]]:
    """App-only access, authenticated with a certificate (recommended by
    Microsoft over a client secret). The plugin signs a client assertion with
    the private key for every token request; the key never leaves this host.

    The token is not requested here; the plugin's own test (test-config) does
    that once the file is written."""
    certificate = os.path.abspath(certificate)
    private_key = os.path.abspath(private_key) if private_key else certificate
    for path in (certificate, private_key):
        if not os.path.isfile(path):
            raise Exception(f"No such file: {path}")
    if stat.S_IMODE(os.stat(private_key).st_mode) & 0o077:
        print(f"Warning: {private_key} is accessible to other users; "
              f"restrict it (e.g. chmod 600) to the user the mail system runs as.",
              file=sys.stderr)
    tokens:Dict[str,Union[str,int]] = {
        'grant_type': 'client_credentials',
        'scope': cloud_config["app_scope"],
        'token_endpoint': outlook_token_endpoint(tenant, cloud_config),
        'client_id': client_id,
        'client_certificate_file': certificate,
        'access_token': '',
        'expiry': 0,
    }
    if private_key != certificate:
        tokens['client_private_key_file'] = private_key
    if mailbox:
        tokens['user'] = mailbox
    return tokens


def outlook_get_token_by_client_credentials(client_id:str, client_secret:str, tenant:str, cloud_config:Dict[str,str], mailbox:Optional[str]) -> Dict[str,Union[str,int]]:
    """App-only access (no user sign-in, no refresh token).

    Needs an application permission (e.g. SMTP.SendAsApp, or
    IMAP.AccessAsApp/POP.AccessAsApp) with admin consent, and the app's service
    principal registered in Exchange Online with access to the mailbox."""
    token_endpoint = outlook_token_endpoint(tenant, cloud_config)
    scope = cloud_config["app_scope"]
    content = post_token_request(token_endpoint, {
        'grant_type': 'client_credentials',
        'client_id': client_id,
        'client_secret': client_secret,
        'scope': scope,
    })
    if "access_token" not in content:
        raise Exception(f"No access token in response (fields: {', '.join(sorted(content.keys()))}).")
    print("Acquired app-only token.", file=sys.stderr)
    # The plugin requests new tokens itself, so it needs everything a request
    # takes; the file is created readable by its owner only.
    tokens:Dict[str,Union[str,int]] = {
        'grant_type': 'client_credentials',
        'scope': scope,
        'token_endpoint': token_endpoint,
        'client_id': client_id,
        'client_secret': client_secret,
        'access_token': content["access_token"],
        'expiry': expiry_from_response(content),
    }
    if mailbox:
        tokens['user'] = mailbox
    return tokens


CLIENT_CREDENTIALS_KEYS = ('grant_type', 'scope', 'client_id', 'client_secret',
                           'client_certificate_file', 'client_private_key_file')


def get_token_outlook(client_id:str, client_secret:Optional[str], tenant:str, flow:str, output_filename:str, merge_existing:bool, cloud_config:Dict[str,str], mailbox:Optional[str], certificate:Optional[str] = None, private_key:Optional[str] = None) -> None:
    removed_keys:tuple = ()
    if flow == 'client-credentials' and certificate:
        tokens = outlook_client_credentials_with_certificate(client_id, tenant, cloud_config, mailbox, certificate, private_key)
        removed_keys = ('client_secret', 'refresh_token', 'client_private_key_file')
    elif flow == 'client-credentials':
        if not client_secret:
            raise Exception("The client credentials flow requires a client secret or a certificate.")
        tokens = outlook_get_token_by_client_credentials(client_id, client_secret, tenant, cloud_config, mailbox)
        removed_keys = ('client_certificate_file', 'client_private_key_file', 'refresh_token')
    elif flow == 'device':
        tokens = outlook_get_initial_tokens_by_device_flow(client_id, tenant, cloud_config)
    else:
        state = secrets.token_urlsafe(32)
        pkce = pkce_pair()
        code = outlook_get_authorization_code(client_id, tenant, cloud_config, state, pkce['challenge'])
        tokens = outlook_get_initial_tokens(client_id, client_secret, tenant, code, cloud_config, pkce['verifier'])
    if mailbox and 'user' not in tokens:
        tokens['user'] = mailbox

    def adjust(contents:dict) -> None:
        for key in removed_keys:
            if key not in tokens:
                contents.pop(key, None)
        if flow != 'client-credentials' and contents.get('grant_type') == 'client_credentials':
            # Switching an existing file back to delegated access: its app-only
            # settings belong to the other application and must not be kept.
            for key in CLIENT_CREDENTIALS_KEYS:
                if key not in tokens:
                    contents.pop(key, None)
            print("Removed client credentials settings from the existing token file.", file=sys.stderr)

    dump_overwrite(tokens, output_filename, merge_existing, adjust)
    if output_filename == '-':
        return
    print(f"Wrote token to {output_filename}.", file=sys.stderr)
    if flow == 'client-credentials' and certificate:
        if not os.path.exists(TEST_TOOL_PATH):
            print("Run 'sasl-xoauth2-tool test-token-refresh' on the file to check it.", file=sys.stderr)
            return
        print("Requesting a token with the certificate to check the setup:", file=sys.stderr)
        sys.exit(run_test_tool(['--token', output_filename]))

##########


parser = argparse.ArgumentParser()
parser.add_argument('--version', action='version', version='%(prog)s ' + VERSION)
subparse = parser.add_subparsers()


def argparse_get_parser() -> argparse.ArgumentParser:
  return parser


def subcommand_get_token(args:argparse.Namespace) -> None:
    if args.overwrite_existing_token and args.output_file == '-':
        parser.error("--overwrite-existing-token needs an output file.")
    if args.overwrite_existing_token and not os.path.isfile(args.output_file):
        raise Exception("Cannot overwrite nonexistent token file {}".format(args.output_file))
    if (args.certificate or args.private_key) and not args.client_credentials:
        parser.error("--certificate and --private-key are only used with --client-credentials.")
    if args.service == 'outlook':
        if not args.tenant:
            parser.error("'outlook' service requires 'tenant' argument.")
        if args.use_device_flow and args.client_credentials:
            parser.error("--use-device-flow and --client-credentials are mutually exclusive.")
        flow = 'client-credentials' if args.client_credentials else ('device' if args.use_device_flow else 'auth-code')
        if flow == 'client-credentials' and args.tenant in ('consumers', 'common', 'organizations'):
            parser.error("--client-credentials requires --tenant=TENANT_ID (or the tenant's domain).")
        if args.client_secret is None and flow != 'device' and not args.certificate:
            prompt = ('Please enter OAuth2 client secret: ' if flow == 'client-credentials' else
                      'Please enter OAuth2 client secret (leave empty for public clients): ')
            args.client_secret = getpass.getpass(prompt)
        cloud_config = outlook_get_cloud_config(args.cloud, args.login_base, args.scope)
        if args.scope and flow == 'client-credentials':
            cloud_config["app_scope"] = args.scope
        get_token_outlook(
            args.client_id,
            args.client_secret,
            args.tenant,
            flow,
            args.output_file,
            args.overwrite_existing_token,
            cloud_config,
            args.mailbox,
            args.certificate,
            args.private_key,
        )
    elif args.service == 'gmail':
        if args.cloud != 'public' or args.login_base:
            print("Warning: --cloud and --login-base are only used with the 'outlook' service and will be ignored.",
                  file=sys.stderr)
        if not args.client_secret:
            args.client_secret = getpass.getpass('Please enter OAuth2 client secret: ')
        if not args.client_secret:
            parser.error("'gmail' service requires 'client-secret' argument.")
        if not args.scope:
            parser.error("'gmail' service requires 'scope' argument.")
        get_token_gmail(
            args.client_id,
            args.client_secret,
            args.scope,
            args.output_file,
            args.local_listen_port,
            args.local_listen_address,
            args.overwrite_existing_token,
        )


sp_get_token = subparse.add_parser('get-token', description='Fetches initial access and refresh tokens from an OAuth 2 provider')
sp_get_token.set_defaults(func=subcommand_get_token)
sp_get_token.add_argument(
    'service', choices=['outlook', 'gmail'],
    help="service type",
)
sp_get_token.add_argument(
    '--client-id', required=True,
    help="required for both services",
)
sp_get_token.add_argument(
    '--tenant', default='consumers',
    help="wanted by 'outlook' (defaults to 'consumers')",
)
sp_get_token.add_argument(
    '--client-secret',
    help="required for 'gmail' and for --client-credentials, optional for "
         "other 'outlook' flows; will prompt the user if not given",
)
sp_get_token.add_argument(
    "--use-device-flow",
    default=False,
    action='store_true',
    help="use simplified device flow for Outlook/Azure",
)
sp_get_token.add_argument(
    "--client-credentials",
    default=False,
    action='store_true',
    help="use the app-only client credentials flow for Outlook/Azure (no user "
         "sign-in, no refresh token); requires --tenant=TENANT_ID and a client secret",
)
sp_get_token.add_argument(
    '--certificate',
    help="with --client-credentials: authenticate with this certificate (PEM) "
         "instead of a client secret (recommended); upload it to the app "
         "registration under 'Certificates & secrets'",
)
sp_get_token.add_argument(
    '--private-key',
    help="with --certificate: the certificate's private key (PEM, "
         "unencrypted), if not in the certificate file",
)
sp_get_token.add_argument(
    '--mailbox',
    help="mailbox (email address) to authenticate as; stored as 'user' in the "
         "token file. Required by --client-credentials unless Postfix's "
         "sasl_passwd user name already is the mailbox address.",
)
sp_get_token.add_argument(
    '--cloud', default='public',
    choices=list(OUTLOOK_CLOUD_CONFIGS.keys()),
    help="Microsoft 365 cloud environment (default: public). "
         "Use 'usgov' for US Government GCC High, 'usgov-dod' for US Government DoD, "
         "or 'china' for 21Vianet. Only used with 'outlook' service.",
)
sp_get_token.add_argument(
    '--login-base',
    help="override the Entra login base URL (e.g. https://login.microsoftonline.us). "
         "Takes precedence over --cloud. Only used with 'outlook' service.",
)
sp_get_token.add_argument(
    '--scope',
    help="for 'gmail': required OAuth2 scope. "
         "For 'outlook': override the default scope from --cloud "
         "(e.g. 'offline_access https://outlook.office365.us/SMTP.Send', "
         "or 'https://outlook.office365.us/.default' with --client-credentials).",
)
sp_get_token.add_argument(
    '--overwrite-existing-token',
    default=False,
    action='store_true',
    help='overwrite existing token file (preserves extra fields)',
)
sp_get_token.add_argument(
    '--local-listen-port', type=int, default=54332,
    help='port to launch local http listener on',
)
sp_get_token.add_argument(
    '--local-listen-address', default='127.0.0.1',
    help="address to bind the local http listener to (default: 127.0.0.1)",
)
sp_get_token.add_argument(
    'output_file', nargs='?', type=str, default='-',
    help="output file, '-' for stdout",
)


def subcommand_test_config(args:argparse.Namespace) -> None:
  test_args = []
  if args.config_file:
    test_args.extend(['--config', args.config_file])
  sys.exit(run_test_tool(test_args))


sp_test_config = subparse.add_parser('test-config', description='Tests a sasl-xoauth2 config file for syntax errors')
sp_test_config.set_defaults(func=subcommand_test_config)
sp_test_config.add_argument(
    '--config-file',
    help="config file path (defaults to '%s')" % DEFAULT_CONFIG_FILE,
)


def subcommand_test_token_refresh(args:argparse.Namespace) -> None:
  test_args = ['--token', args.token_file]
  if args.config_file:
    test_args.extend(['--config', args.config_file])
  sys.exit(run_test_tool(test_args))


sp_test_token_refresh = subparse.add_parser(
    'test-token-refresh',
    description='Tests that a token can be refreshed (i.e., that the OAuth 2 flow is working correctly). '
                'The token file is not modified. Exit status: 0 on success, 1 on a transient failure '
                '(e.g. network problem, provider outage), 2 on a failure that needs action (e.g. '
                'invalid configuration, rejected token, unwritable token directory). Run it as the '
                'user the mail system runs as (e.g. sudo -u postfix) to also check permissions.')
sp_test_token_refresh.set_defaults(func=subcommand_test_token_refresh)
sp_test_token_refresh.add_argument(
    '--config-file',
    help="config file path (defaults to '%s')" % DEFAULT_CONFIG_FILE,
)
sp_test_token_refresh.add_argument(
    'token_file',
    help="file containing initial access token",
)

##########


def main() -> None:
    if argcomplete:
        argcomplete.autocomplete(parser)
    elif '_ARGCOMPLETE' in os.environ:
        logging.error('Argument completion requested but the "argcomplete" '
                      'module is not installed. '
                      'Maybe you want to "apt install python3-argcomplete"')
        sys.exit(1)
    args = parser.parse_args()
    if hasattr(args, 'func'):
      args.func(args)
    else:
      parser.print_help()
      sys.exit(1)


if __name__ == '__main__':
    main()
